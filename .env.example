# ---------- Postgres (consumed by docker-compose) ----------
POSTGRES_USER=wfp
POSTGRES_PASSWORD=wfp_password
POSTGRES_DB=wfp
POSTGRES_PORT=5432

# ---------- Backend (copy to backend/.env) ----------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://wfp:wfp_password@localhost:5432/wfp?schema=public

# JWT / auth (CHANGE in any non-local environment; min 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# CORS: frontend origin allowed to send credentialed requests
CORS_ORIGIN=http://localhost:3000

# Background job (simulated shipping worker)
SHIPMENT_JOB_DELAY_MS=3000

# Test hooks: enabled when NODE_ENV=test OR ENABLE_TEST_HOOKS=true
ENABLE_TEST_HOOKS=false

# ---------- Frontend (copy to frontend/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
